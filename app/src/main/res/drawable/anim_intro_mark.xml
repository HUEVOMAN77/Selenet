<?xml version="1.0" encoding="utf-8"?>
<!--
  Beat 1 y 2 del intro (0,0 s a 1,3 s):

  0-0,8 s   los cuatro trazos se dibujan solos, escalonados: palo, punta, play, bandeja.
            Cada trazo enciende su group (alpha) en el mismo instante en que arranca su
            recorte (trimPathEnd), para que no se vea entero antes de su turno.
  0,82 s    aparece el relleno con alfa y un rebote de escala (overshoot).
  1,0 s     el trazo se apaga: el estado final es el icono relleno, igual al del launcher.

  Todos los nombres existen en intro_mark.xml. Si se cambia ahi, hay que cambiar aqui.
-->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:drawable="@drawable/intro_mark">

    <target android:name="g_stem">
        <objectAnimator
            android:duration="80"
            android:propertyName="alpha"
            android:valueFrom="0"
            android:valueTo="1"
            android:valueType="floatType" />
    </target>

    <target android:name="o_stem">
        <objectAnimator
            android:duration="360"
            android:interpolator="@interpolator/intro_ease_out"
            android:propertyName="trimPathEnd"
            android:valueFrom="0"
            android:valueTo="1"
            android:valueType="floatType" />
    </target>

    <target android:name="g_head">
        <objectAnimator
            android:duration="80"
            android:propertyName="alpha"
            android:startOffset="200"
            android:valueFrom="0"
            android:valueTo="1"
            android:valueType="floatType" />
    </target>

    <target android:name="o_head">
        <objectAnimator
            android:duration="320"
            android:interpolator="@interpolator/intro_ease_out"
            android:propertyName="trimPathEnd"
            android:startOffset="200"
            android:valueFrom="0"
            android:valueTo="1"
            android:valueType="floatType" />
    </target>

    <target android:name="g_play">
        <objectAnimator
            android:duration="80"
            android:propertyName="alpha"
            android:startOffset="320"
            android:valueFrom="0"
            android:valueTo="1"
            android:valueType="floatType" />
    </target>

    <target android:name="o_play">
        <objectAnimator
            android:duration="420"
            android:interpolator="@interpolator/intro_ease_out"
            android:propertyName="trimPathEnd"
            android:startOffset="320"
            android:valueFrom="0"
            android:valueTo="1"
            android:valueType="floatType" />
    </target>

    <target android:name="g_tray">
        <objectAnimator
            android:duration="80"
            android:propertyName="alpha"
            android:startOffset="520"
            android:valueFrom="0"
            android:valueTo="1"
            android:valueType="floatType" />
    </target>

    <target android:name="o_tray">
        <objectAnimator
            android:duration="300"
            android:interpolator="@interpolator/intro_ease_out"
            android:propertyName="trimPathEnd"
            android:startOffset="520"
            android:valueFrom="0"
            android:valueTo="1"
            android:valueType="floatType" />
    </target>

    <target android:name="fill">
        <objectAnimator
            android:duration="240"
            android:interpolator="@android:interpolator/decelerate_quad"
            android:propertyName="alpha"
            android:startOffset="820"
            android:valueFrom="0"
            android:valueTo="1"
            android:valueType="floatType" />
        <objectAnimator
            android:duration="460"
            android:interpolator="@android:interpolator/overshoot"
            android:propertyName="scaleX"
            android:startOffset="820"
            android:valueFrom="0.9"
            android:valueTo="1"
            android:valueType="floatType" />
        <objectAnimator
            android:duration="460"
            android:interpolator="@android:interpolator/overshoot"
            android:propertyName="scaleY"
            android:startOffset="820"
            android:valueFrom="0.9"
            android:valueTo="1"
            android:valueType="floatType" />
    </target>

    <target android:name="outline">
        <objectAnimator
            android:duration="320"
            android:interpolator="@android:interpolator/accelerate_quad"
            android:propertyName="alpha"
            android:startOffset="1000"
            android:valueFrom="1"
            android:valueTo="0"
            android:valueType="floatType" />
    </target>
</animated-vector>
