<?xml version="1.0" encoding="utf-8"?>
<!--
  Bubble de las visitas (coach marks). Lo posiciona CoachMarks encima del ancla, con
  ancho fijo y altura medida; por eso el root acepta LayoutParams desde codigo.
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/coach_card"
    style="@style/Widget.Ytdl.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/card_padding">

        <TextView
            android:id="@+id/coach_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/Text.Ytdl.CoachTitle" />

        <TextView
            android:id="@+id/coach_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:textAppearance="@style/Text.Ytdl.CoachBody" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:gravity="end|center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/coach_skip"
                style="@style/Widget.Ytdl.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/coach_saltear" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/coach_next"
                style="@style/Widget.Ytdl.Button.Tonal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_s"
                android:text="@string/coach_next" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
