<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:overScrollMode="never"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_padding"
        android:paddingEnd="@dimen/screen_padding"
        android:paddingTop="@dimen/space_xxl"
        android:paddingBottom="@dimen/space_xxl">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/portada_ajustes"
            android:textAppearance="@style/Text.Ytdl.ScreenTitle" />

        <TextView
            android:id="@+id/screen_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:text="@string/portada_ajustes_sub"
            android:textAppearance="@style/Text.Ytdl.ScreenSubtitle" />

        <!-- MOTOR -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Ytdl.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.card.MaterialCardView
                        style="@style/Widget.Ytdl.Badge"
                        android:layout_width="@dimen/badge_size_sm"
                        android:layout_height="@dimen/badge_size_sm">

                        <ImageView
                            android:layout_width="@dimen/icon_size_sm"
                            android:layout_height="@dimen/icon_size_sm"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_memory" />
                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_m"
                        android:layout_weight="1"
                        android:text="@string/ajustes_motor"
                        android:textAppearance="@style/Text.Ytdl.ItemTitle" />
                </LinearLayout>

                <TextView
                    android:id="@+id/lbl_engine_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m"
                    android:textAppearance="@style/Text.Ytdl.ItemBody" />

                <TextView
                    android:id="@+id/lbl_engine_version"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:textAppearance="@style/Text.Ytdl.ItemMeta" />

                <TextView
                    android:id="@+id/lbl_engine_updated"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textAppearance="@style/Text.Ytdl.ItemMeta" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_update_engine"
                    style="@style/Widget.Ytdl.Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m"
                    android:text="@string/ajustes_actualizar"
                    app:icon="@drawable/ic_refresh" />

                <TextView
                    android:id="@+id/lbl_engine_hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_s"
                    android:textAppearance="@style/Text.Ytdl.ItemMeta" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- CARPETA -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Ytdl.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/card_gap">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.card.MaterialCardView
                        style="@style/Widget.Ytdl.Badge"
                        android:layout_width="@dimen/badge_size_sm"
                        android:layout_height="@dimen/badge_size_sm">

                        <ImageView
                            android:layout_width="@dimen/icon_size_sm"
                            android:layout_height="@dimen/icon_size_sm"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_folder" />
                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_m"
                        android:layout_weight="1"
                        android:text="@string/ajustes_carpeta"
                        android:textAppearance="@style/Text.Ytdl.ItemTitle" />
                </LinearLayout>

                <TextView
                    android:id="@+id/lbl_dir"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m"
                    android:textIsSelectable="true"
                    android:textAppearance="@style/Text.Ytdl.ItemBody"
                    android:textColor="?attr/colorPrimary" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_s"
                    android:text="@string/ajustes_carpeta_nota"
                    android:textAppearance="@style/Text.Ytdl.ItemMeta" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_pick_dir"
                        style="@style/Widget.Ytdl.Button.Tonal"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/ajustes_cambiar_carpeta" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_copy_dir"
                        style="@style/Widget.Ytdl.Button.Outlined"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_s"
                        android:text="@string/copiar_ruta" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- CALIDAD -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_quality"
            style="@style/Widget.Ytdl.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/card_gap"
            android:checkable="false"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.card.MaterialCardView
                        style="@style/Widget.Ytdl.Badge"
                        android:layout_width="@dimen/badge_size_sm"
                        android:layout_height="@dimen/badge_size_sm">

                        <ImageView
                            android:layout_width="@dimen/icon_size_sm"
                            android:layout_height="@dimen/icon_size_sm"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_layers" />
                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_m"
                        android:layout_weight="1"
                        android:text="@string/ajustes_calidad"
                        android:textAppearance="@style/Text.Ytdl.ItemTitle" />
                </LinearLayout>

                <TextView
                    android:id="@+id/lbl_quality"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m"
                    android:textAppearance="@style/Text.Ytdl.ItemBody"
                    android:textColor="?attr/colorPrimary" />

                <TextView
                    android:id="@+id/lbl_quality_hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_s"
                    android:text="@string/ajustes_calidad_nota"
                    android:textAppearance="@style/Text.Ytdl.ItemMeta" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- REGISTRO -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Ytdl.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/card_gap">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.card.MaterialCardView
                        style="@style/Widget.Ytdl.Badge"
                        android:layout_width="@dimen/badge_size_sm"
                        android:layout_height="@dimen/badge_size_sm">

                        <ImageView
                            android:layout_width="@dimen/icon_size_sm"
                            android:layout_height="@dimen/icon_size_sm"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_terminal" />
                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_m"
                        android:layout_weight="1"
                        android:text="@string/ajustes_registro"
                        android:textAppearance="@style/Text.Ytdl.ItemTitle" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switch_log"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/ajustes_registro" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m"
                    android:text="@string/ajustes_registro_sub"
                    android:textAppearance="@style/Text.Ytdl.ItemMeta" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- DATOS: la cola puede quedarse esperando WiFi -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Ytdl.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/card_gap">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.card.MaterialCardView
                        style="@style/Widget.Ytdl.Badge"
                        android:layout_width="@dimen/badge_size_sm"
                        android:layout_height="@dimen/badge_size_sm">

                        <ImageView
                            android:layout_width="@dimen/icon_size_sm"
                            android:layout_height="@dimen/icon_size_sm"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_wifi" />
                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_m"
                        android:layout_weight="1"
                        android:text="@string/ajustes_solo_wifi"
                        android:textAppearance="@style/Text.Ytdl.ItemTitle" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switch_wifi"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/ajustes_solo_wifi" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m"
                    android:text="@string/ajustes_solo_wifi_sub"
                    android:textAppearance="@style/Text.Ytdl.ItemMeta" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- AVISOS: el aviso suelto de cada descarga terminada -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Ytdl.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/card_gap">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.card.MaterialCardView
                        style="@style/Widget.Ytdl.Badge"
                        android:layout_width="@dimen/badge_size_sm"
                        android:layout_height="@dimen/badge_size_sm">

                        <ImageView
                            android:layout_width="@dimen/icon_size_sm"
                            android:layout_height="@dimen/icon_size_sm"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_bell" />
                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_m"
                        android:layout_weight="1"
                        android:text="@string/ajustes_avisos"
                        android:textAppearance="@style/Text.Ytdl.ItemTitle" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switch_avisos"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/ajustes_avisos" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m"
                    android:text="@string/ajustes_avisos_sub"
                    android:textAppearance="@style/Text.Ytdl.ItemMeta" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- FALLO DETECTADO -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/crash_card"
            style="@style/Widget.Ytdl.Card.Tonal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/card_gap"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.card.MaterialCardView
                        style="@style/Widget.Ytdl.Badge"
                        android:layout_width="@dimen/badge_size_sm"
                        android:layout_height="@dimen/badge_size_sm"
                        app:cardBackgroundColor="@color/state_error_bg">

                        <ImageView
                            android:layout_width="@dimen/icon_size_sm"
                            android:layout_height="@dimen/icon_size_sm"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_state_error"
                            app:tint="@color/state_error_fg" />
                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_m"
                        android:layout_weight="1"
                        android:text="@string/ajustes_fallo"
                        android:textAppearance="@style/Text.Ytdl.ItemTitle" />
                </LinearLayout>

                <TextView
                    android:id="@+id/crash_detail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_s"
                    android:ellipsize="end"
                    android:maxLines="3"
                    android:textAppearance="@style/Text.Ytdl.ItemMeta"
                    tools:text="java.lang.NullPointerException" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_s"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_crash_copy"
                        style="@style/Widget.Ytdl.Button.Text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="40dp"
                        android:text="@string/btn_fallo_copiar" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_crash_clear"
                        style="@style/Widget.Ytdl.Button.Text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_s"
                        android:minHeight="40dp"
                        android:text="@string/btn_fallo_borrar" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- AVANZADO -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Ytdl.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/card_gap">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.card.MaterialCardView
                        style="@style/Widget.Ytdl.Badge"
                        android:layout_width="@dimen/badge_size_sm"
                        android:layout_height="@dimen/badge_size_sm">

                        <ImageView
                            android:layout_width="@dimen/icon_size_sm"
                            android:layout_height="@dimen/icon_size_sm"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_settings" />
                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_m"
                        android:layout_weight="1"
                        android:text="@string/ajustes_avanzado"
                        android:textAppearance="@style/Text.Ytdl.ItemTitle" />
                </LinearLayout>

                <!-- Intro: sin intro / corto / completo. Se elige en un dialog, como la calidad. -->
                <LinearLayout
                    android:id="@+id/card_intro"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:orientation="vertical"
                    android:paddingTop="@dimen/space_s"
                    android:paddingBottom="@dimen/space_s">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/ajustes_intro"
                        android:textAppearance="@style/Text.Ytdl.ItemBody" />

                    <TextView
                        android:id="@+id/lbl_intro_state"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textAppearance="@style/Text.Ytdl.ItemMeta" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_s"
                        android:text="@string/ajustes_intro_sub"
                        android:textAppearance="@style/Text.Ytdl.ItemMeta" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_l"
                    android:text="@string/ajustes_tutorial"
                    android:textAppearance="@style/Text.Ytdl.ItemBody" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/ajustes_tutorial_sub"
                    android:textAppearance="@style/Text.Ytdl.ItemMeta" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_tutorial"
                    style="@style/Widget.Ytdl.Button.Tonal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m"
                    android:text="@string/ajustes_tutorial" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
