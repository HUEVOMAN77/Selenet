<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:overScrollMode="never"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_padding"
        android:paddingEnd="@dimen/screen_padding"
        android:paddingTop="@dimen/space_xxl"
        android:paddingBottom="@dimen/space_xxl">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/portada_ajustes"
            android:textAppearance="@style/Text.Ytdl.ScreenTitle" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:text="@string/portada_ajustes_sub"
            android:textAppearance="@style/Text.Ytdl.ScreenSubtitle" />

        <!-- MOTOR -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Ytdl.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.card.MaterialCardView
                        style="@style/Widget.Ytdl.Badge"
                        android:layout_width="@dimen/badge_size_sm"
                        android:layout_height="@dimen/badge_size_sm">

                        <ImageView
                            android:layout_width="@dimen/icon_size_sm"
                            android:layout_height="@dimen/icon_size_sm"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_memory" />
                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_m"
                        android:layout_weight="1"
                        android:text="@string/ajustes_motor"
                        android:textAppearance="@style/Text.Ytdl.ItemTitle" />
                </LinearLayout>

                <TextView
                    android:id="@+id/lbl_engine_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m"
                    android:textAppearance="@style/Text.Ytdl.ItemBody" />

                <TextView
                    android:id="@+id/lbl_engine_version"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:textAppearance="@style/Text.Ytdl.ItemMeta" />

                <TextView
                    android:id="@+id/lbl_engine_updated"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textAppearance="@style/Text.Ytdl.ItemMeta" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_update_engine"
                    style="@style/Widget.Ytdl.Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m"
                    android:text="@string/ajustes_actualizar"
                    app:icon="@drawable/ic_refresh" />

                <TextView
                    android:id="@+id/lbl_engine_hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_s"
                    android:textAppearance="@style/Text.Ytdl.ItemMeta" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- CARPETA -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Ytdl.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/card_gap">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.card.MaterialCardView
                        style="@style/Widget.Ytdl.Badge"
                        android:layout_width="@dimen/badge_size_sm"
                        android:layout_height="@dimen/badge_size_sm">

                        <ImageView
                            android:layout_width="@dimen/icon_size_sm"
                            android:layout_height="@dimen/icon_size_sm"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_folder" />
                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_m"
                        android:layout_weight="1"
                        android:text="@string/ajustes_carpeta"
                        android:textAppearance="@style/Text.Ytdl.ItemTitle" />
                </LinearLayout>

                <TextView
                    android:id="@+id/lbl_dir"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m"
                    android:textIsSelectable="true"
                    android:textAppearance="@style/Text.Ytdl.ItemBody"
                    android:textColor="?attr/colorPrimary" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_pick_dir"
                        style="@style/Widget.Ytdl.Button.Tonal"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/ajustes_cambiar_carpeta" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_copy_dir"
                        style="@style/Widget.Ytdl.Button.Outlined"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_s"
                        android:text="@string/copiar_ruta" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- CALIDAD -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Ytdl.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/card_gap">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.card.MaterialCardView
                        style="@style/Widget.Ytdl.Badge"
                        android:layout_width="@dimen/badge_size_sm"
                        android:layout_height="@dimen/badge_size_sm">

                        <ImageView
                            android:layout_width="@dimen/icon_size_sm"
                            android:layout_height="@dimen/icon_size_sm"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_layers" />
                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_m"
                        android:layout_weight="1"
                        android:text="@string/ajustes_calidad"
                        android:textAppearance="@style/Text.Ytdl.ItemTitle" />
                </LinearLayout>

                <TextView
                    android:id="@+id/lbl_quality"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m"
                    android:textAppearance="@style/Text.Ytdl.ItemMeta" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- REGISTRO -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Ytdl.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/card_gap">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.card.MaterialCardView
                        style="@style/Widget.Ytdl.Badge"
                        android:layout_width="@dimen/badge_size_sm"
                        android:layout_height="@dimen/badge_size_sm">

                        <ImageView
                            android:layout_width="@dimen/icon_size_sm"
                            android:layout_height="@dimen/icon_size_sm"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_terminal" />
                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_m"
                        android:layout_weight="1"
                        android:text="@string/ajustes_registro"
                        android:textAppearance="@style/Text.Ytdl.ItemTitle" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switch_log"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/ajustes_registro" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m"
                    android:text="@string/ajustes_registro_sub"
                    android:textAppearance="@style/Text.Ytdl.ItemMeta" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- AVANZADO -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Ytdl.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/card_gap">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.card.MaterialCardView
                        style="@style/Widget.Ytdl.Badge"
                        android:layout_width="@dimen/badge_size_sm"
                        android:layout_height="@dimen/badge_size_sm">

                        <ImageView
                            android:layout_width="@dimen/icon_size_sm"
                            android:layout_height="@dimen/icon_size_sm"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_settings" />
                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_m"
                        android:layout_weight="1"
                        android:text="@string/ajustes_avanzado"
                        android:textAppearance="@style/Text.Ytdl.ItemTitle" />
                </LinearLayout>

                <TextView
                    android:id="@+id/lbl_hybrid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m"
                    android:text="@string/ajustes_hibrido"
                    android:textAppearance="@style/Text.Ytdl.ItemBody" />

                <TextView
                    android:id="@+id/lbl_hybrid_state"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/ajustes_hibrido_off"
                    android:textAppearance="@style/Text.Ytdl.ItemMeta" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_hybrid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_s"
                    android:enabled="false"
                    android:text="@string/modo_hibrido"
                    android:textAppearance="@style/Text.Ytdl.ItemBody" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
