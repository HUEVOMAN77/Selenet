<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="@dimen/screen_padding"
    android:paddingEnd="@dimen/screen_padding"
    android:paddingTop="@dimen/space_xl"
    android:paddingBottom="@dimen/space_m">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/portada_descargas"
        android:textAppearance="@style/Text.Ytdl.ScreenTitle" />

    <TextView
        android:id="@+id/screen_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xs"
        android:text="@string/portada_descargas_sub"
        android:textAppearance="@style/Text.Ytdl.ScreenSubtitle" />

    <!-- Bloque principal: link + formato + accion -->
    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.Ytdl.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_l">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/card_padding">

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Ytdl.Input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:endIconContentDescription="@string/clear_link"
                app:endIconMode="clear_text"
                app:hintEnabled="false"
                app:startIconDrawable="@drawable/ic_link">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/url_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/hint_url"
                    android:hint="@string/hint_url"
                    android:imeOptions="actionDone"
                    android:inputType="textUri"
                    android:maxLines="2"
                    android:minHeight="56dp"
                    android:textAppearance="@style/Text.Ytdl.ItemBody" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/fmt_toggle_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:background="@drawable/segment_group_bg"
                android:padding="4dp"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_fmt_auto"
                    style="@style/Widget.Ytdl.Segment"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/fmt_todos" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_fmt_mp4"
                    style="@style/Widget.Ytdl.Segment"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/fmt_video" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_fmt_mp3"
                    style="@style/Widget.Ytdl.Segment"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/fmt_audio" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_add"
                style="@style/Widget.Ytdl.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:text="@string/btn_agregar"
                app:icon="@drawable/ic_download" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/space_xs"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_search_video"
                    style="@style/Widget.Ytdl.Button.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="40dp"
                    android:text="@string/btn_buscar"
                    app:icon="@drawable/ic_search" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_clear_part"
                    style="@style/Widget.Ytdl.Button.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_s"
                    android:minHeight="40dp"
                    android:text="@string/btn_borrar_part" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Estado de lectura de formatos -->
    <LinearLayout
        android:id="@+id/status_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_m"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <ProgressBar
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:indeterminateTint="@color/primary" />

        <TextView
            android:id="@+id/status_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_s"
            android:textAppearance="@style/Text.Ytdl.ItemMeta" />
    </LinearLayout>

    <!-- Encabezado de la cola con buscador -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_l"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/seccion_cola"
            android:textAppearance="@style/Text.Ytdl.SectionTitle" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_search"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@string/buscar_en_cola"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:icon="@drawable/ic_search"
            app:iconSize="18dp"
            app:iconTint="@color/on_surface_variant" />
    </LinearLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/filter_layout"
        style="@style/Widget.Ytdl.Input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_s"
        android:visibility="gone"
        app:hintEnabled="false"
        app:startIconDrawable="@drawable/ic_search">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/filter_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:contentDescription="@string/buscar_en_cola"
            android:hint="@string/buscar_en_cola_hint"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1"
            android:minHeight="48dp"
            android:textAppearance="@style/Text.Ytdl.ItemBody" />
    </com.google.android.material.textfield.TextInputLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/queue_list"
        android:layoutAnimation="@anim/list_enter"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/space_s"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingBottom="@dimen/space_s" />

    <LinearLayout
        android:id="@+id/queue_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/space_xxl"
        android:visibility="gone">

        <ImageView
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:alpha="0.38"
            android:contentDescription="@null"
            android:src="@drawable/ic_download"
            app:tint="@color/on_surface_variant" />

        <TextView
            android:id="@+id/queue_empty_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:gravity="center"
            android:text="@string/cola_vacia"
            android:textAppearance="@style/Text.Ytdl.Empty" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:gravity="center"
            android:text="@string/cola_vacia_pista"
            android:textAppearance="@style/Text.Ytdl.ItemMeta" />
    </LinearLayout>

    <!-- Actividad del motor: oculta salvo que se habilite en Ajustes -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/log_card"
        style="@style/Widget.Ytdl.Card.Tonal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_s"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/card_padding">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/seccion_log"
                    android:textAppearance="@style/Text.Ytdl.SectionTitle" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_copy_log"
                    style="@style/Widget.Ytdl.Button.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="40dp"
                    android:text="@string/btn_copiar_log" />
            </LinearLayout>

            <ScrollView
                android:id="@+id/log_scroll"
                android:layout_width="match_parent"
                android:layout_height="@dimen/log_height"
                android:layout_marginTop="@dimen/space_s"
                android:overScrollMode="never"
                android:scrollbars="none">

                <TextView
                    android:id="@+id/log_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:textIsSelectable="true"
                    android:textAppearance="@style/Text.Ytdl.Log" />
            </ScrollView>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
