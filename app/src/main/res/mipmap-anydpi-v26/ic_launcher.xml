<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 8 y superiores: el arte completo vive en el fondo (ic_launcher_bg.png, ya pensado
  para que el recorte circular no corte nada) y el primer plano esta vacio a proposito.
  El monochrome es el que usan los temas de Material You: una silueta blanca del mismo gesto.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@mipmap/ic_launcher_bg" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
