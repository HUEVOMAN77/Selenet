<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- INTERNET: el motor descarga desde los sitios. WAKE_LOCK: evita que el CPU duerma
         mientras baja un video. FOREGROUND_SERVICE: muestra la notificacion persistente y
         deja que la cola siga andando con la app cerrada. WRITE_EXTERNAL_STORAGE: con
         targetSdk 28 es lo unico que permite guardar los videos en Movies/Selenet para
         que los vea la galeria; si elegis una carpeta por SAF no se usa. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <!-- ACCESS_NETWORK_STATE: la politica "bajar solo con WiFi" necesita saber que red
         esta activa antes de gastar datos en una descarga de 1080p. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- POST_NOTIFICATIONS: en Android 13+ sin esto el aviso de "terminada" no se ve,
         aunque la notificacion persistente de la cola siga siendo legal. Con targetSdk 28
         el sistema no la pide solo, asi que MainActivity la pide de una vez. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".App"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:requestLegacyExternalStorage="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.YtdlFork">

        <!--
          IntroActivity es la puerta de entrada: decide entre intro, guia de inicio y la app.
          No figura en recientes porque se cierra sola en cuanto entrega.
        -->
        <activity
            android:name=".IntroActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:excludeFromRecents="true"
            android:exported="true"
            android:theme="@style/Theme.Ytdl.Intro">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Guia de 4 pasos; solo la abre IntroActivity o el boton de Ajustes. -->
        <activity
            android:name=".OnboardingActivity"
            android:exported="false"
            android:theme="@style/Theme.YtdlFork" />

        <!-- Busqueda dentro de la app: devuelve el link elegido al que la abrio. -->
        <activity
            android:name=".SearchActivity"
            android:exported="false"
            android:theme="@style/Theme.YtdlFork"
            android:windowSoftInputMode="adjustResize" />

        <!--
          A MainActivity llegan los "Compartir" de otras apps: ahi no tiene sentido
          mostrar el intro, lo que importa es el link.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <!--
              "Abrir en Selenet" desde el menu de otro navegador. Sin esto la unica forma de
              traer un link es Compartir o pegar a mano. Se listan solo los sitios donde
              descargar tiene sentido: si reclamaramos todo https, la app apareceria para
              abrir cualquier pagina y daria error. No se usa android:autoVerify porque las
              app links piden un archivo en el dominio, y ese dominio no es nuestro.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:scheme="http" />
                <data android:host="youtube.com" />
                <data android:host="www.youtube.com" />
                <data android:host="m.youtube.com" />
                <data android:host="music.youtube.com" />
                <data android:host="youtu.be" />
                <data android:host="instagram.com" />
                <data android:host="www.instagram.com" />
                <data android:host="tiktok.com" />
                <data android:host="www.tiktok.com" />
                <data android:host="twitter.com" />
                <data android:host="www.twitter.com" />
                <data android:host="x.com" />
                <data android:host="www.x.com" />
                <data android:host="vimeo.com" />
                <data android:host="www.vimeo.com" />
                <data android:host="facebook.com" />
                <data android:host="www.facebook.com" />
                <data android:host="soundcloud.com" />
                <data android:host="on.soundcloud.com" />
                <data android:host="bandcamp.com" />
                <data android:host="*.bandcamp.com" />
            </intent-filter>
        </activity>

        <service
            android:name=".DownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Comparte los archivos bajados sin exponer rutas reales a otras apps. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.archivos"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
